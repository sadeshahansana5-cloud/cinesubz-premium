# ─── MongoDB ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
MONGODB_DB=cinesubz

# ─── Auth ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-secret

# Turn email/password sign-in on or off across the whole site.
# Set to "false" to disable it (users will see a "sign-in disabled" screen).
EMAIL_LOGIN_ENABLED=true

# ─── Email (for OTP verification codes sent at sign-up) ────────────────────
# Any SMTP provider works: Gmail (with an App Password), Resend, SendGrid, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-address@gmail.com

# ─── Movie API ────────────────────────────────────────────────────────────
# Your CineSubz/Sadaslk API key. Kept server-side only — never sent to the browser.
# If left unset, the app falls back to the same key the original page shipped with.
MOVIE_API_KEY=your-api-key-here

# Optional: comma-separated list of upstream API base URLs (override the default fallback chain)
# MOVIE_API_BASES=https://www.sadaslk.com/api/v1/movie,https://back.asitha.top/api,https://apis.sadas.dev/api/v1/movie
